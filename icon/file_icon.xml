<?xml version="1.0" encoding="utf-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="100%" height="100%">
    <defs>
        <path id="docPath" d="M 134,32 H 312 L 410,130 V 400 A 32,32 0 0,1 378,432 H 134 A 32,32 0 0,1 102,400 V 64 A 32,32 0 0,1 134,32 Z"/>

        <rect id="appIconBase" x="176" y="152" width="160" height="160" rx="36"/>
        <clipPath id="appIconClip">
            <use href="#appIconBase" />
        </clipPath>

        <linearGradient id="docGrad" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#FFFFFF" />
            <stop offset="100%" stop-color="#F2F2F7" />
        </linearGradient>

        <linearGradient id="foldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#FFFFFF" />
            <stop offset="100%" stop-color="#E5E5EA" />
        </linearGradient>

        <linearGradient id="appGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#00F2FE" />
            <stop offset="50%" stop-color="#4FACFE" />
            <stop offset="100%" stop-color="#B066FE" />
        </linearGradient>

        <linearGradient id="badgeGrad" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#3191FF" />
            <stop offset="100%" stop-color="#0055D4" />
        </linearGradient>

        <linearGradient id="glassGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="rgba(255,255,255,0.8)" />
            <stop offset="100%" stop-color="rgba(255,255,255,0.0)" />
        </linearGradient>

        <filter id="docShadow" x="-20%" y="-20%" width="140%" height="140%">
            <feDropShadow dx="0" dy="16" stdDeviation="24" flood-color="#000000" flood-opacity="0.35"/>
            <feDropShadow dx="0" dy="6" stdDeviation="10" flood-color="#000000" flood-opacity="0.2"/>
        </filter>

        <filter id="appShadow" x="-20%" y="-20%" width="140%" height="140%">
            <feDropShadow dx="0" dy="10" stdDeviation="14" flood-color="#000000" flood-opacity="0.3"/>
            <feDropShadow dx="0" dy="4" stdDeviation="6" flood-color="#000000" flood-opacity="0.15"/>
        </filter>

        <filter id="badgeShadow" x="-20%" y="-20%" width="140%" height="140%">
            <feDropShadow dx="0" dy="8" stdDeviation="12" flood-color="#000000" flood-opacity="0.35"/>
        </filter>

        <filter id="glyphShadow" x="-20%" y="-20%" width="140%" height="140%">
            <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="#000000" flood-opacity="0.35"/>
        </filter>

        <filter id="blurShadow">
            <feGaussianBlur stdDeviation="5"/>
        </filter>
    </defs>

    <g filter="url(#docShadow)">
        <use href="#docPath" fill="url(#docGrad)" />
        <use href="#docPath" fill="none" stroke="#FFFFFF" stroke-width="2" />
        <use href="#docPath" fill="none" stroke="#D1D1D6" stroke-width="1" />
    </g>

    <g>
        <path d="M 308,44 V 110 A 24,24 0 0,0 332,134 H 404 Z" fill="#000000" opacity="0.25" filter="url(#blurShadow)" />
        <path d="M 312,32 V 106 A 24,24 0 0,0 336,130 H 410 Z" fill="url(#foldGrad)" />
        <path d="M 312,32 V 106 A 24,24 0 0,0 336,130 H 410 Z" fill="none" stroke="#FFFFFF" stroke-width="2" />
    </g>

    <g filter="url(#appShadow)">
        <use transform="matrix(1,0,0,1,0,0)" href="#appIconBase" fill="url(#appGrad)" />
        
        <g clip-path="url(#appIconClip)">
            <circle cx="200" cy="190" r="120" fill="#ffffff" opacity="0.15" />
            <circle cx="340" cy="300" r="140" fill="#000000" opacity="0.1" />
            <path d="M 176 152 H 336 V 232 Q 256 212 176 252 Z" fill="#ffffff" opacity="0.25" />
        </g>
        
        <use transform="matrix(1,0,0,1,0,0)" href="#appIconBase" fill="none" stroke="url(#glassGrad)" stroke-width="2" />
        <use transform="matrix(1,0,0,1,0,0)" href="#appIconBase" fill="none" stroke="rgba(0, 0, 0, 0.1)" stroke-width="1" />
    </g>

    <g filter="url(#badgeShadow)">
        <rect id="badgeBase" x="60" y="320" width="120" height="120" rx="28" fill="url(#badgeGrad)" />
        
        <rect x="60" y="320" width="120" height="120" rx="28" fill="none" stroke="url(#glassGrad)" stroke-width="2" />
        <rect x="60" y="320" width="120" height="120" rx="28" fill="none" stroke="rgba(0,0,0,0.15)" stroke-width="1" />

        <text x="120" y="415" font-family="'Arial Rounded MT Bold', Arial, sans-serif" font-weight="normal" font-size="98" fill="#FFFFFF" text-anchor="middle" filter="url(#glyphShadow)">S</text>
    </g>
</svg>
