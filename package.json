{
  "name": "scribesync",
  "version": "1.0.0",
  "description": "Offline laptop notebook with iPad network syncing",
  "author": "Gautam Seyal",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.scribesync.app",
    "productName": "ScribeSync",
    "directories": {
      "output": "release",
      "buildResources": "icon"
    },
    "fileAssociations": [
      {
        "ext": "scribe",
        "name": "ScribeSync",
        "description": "ScribeSync Document",
        "icon": "icon/file_icon.ico"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon/scribe_sync_icon_protected.ico"
    },
    "nsis": {
      "installerIcon": "icon/scribe_sync_icon_protected.ico",
      "shortcutName": "ScribeSync",
      "uninstallerIcon": "icon/scribe_sync_icon_protected.ico",
      "installerHeaderIcon": "icon/scribe_sync_icon_protected.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "better-sqlite3": "^12.10.0",
    "express": "^4.18.2",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.13.3"
  }
}
